# Port for Node server (defaults to 3000)
PORT=3000

# Google Gemini API Key (Optional: can also be configured in UI Settings)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional)
# Get a key at: https://platform.openai.com/
OPENAI_API_KEY=

# Ollama local endpoint (Optional, default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
